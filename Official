-- ─────────────────────────────────────────────────────────────── helpers: players
local function others()
	local list = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			list[#list + 1] = other
		end
	end
	return list
end

local function aliveCharacter(other)
	local character = other.Character
	if not character then
		return nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return character, hum
end

local function myCharacter()
	local character = player.Character
	if not character then
		return nil
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) then
		return nil
	end
	return character, hum, hrp
end

local function nearestTarget(maxDistance)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local best, bestDistance = nil, maxDistance or 2500
	for _, other in ipairs(others()) do
		local character, hum = aliveCharacter(other)
		if character then
			local head = character:FindFirstChild("Head")
			local hrp = character:FindFirstChild("HumanoidRootPart")
			local point = (head and head.Position) or (hrp and hrp.Position)
			if point and hum then
				local distance = (point - camera.CFrame.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = point, distance
				end
			end
		end
	end
	return best, bestDistance
end

local function findPlayer(query)
	query = string.lower(query or "")
	if query == "" then
		return nil
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if string.lower(other.Name) == query or string.lower(other.DisplayName) == query then
			return other
		end
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(other.Name), query, 1, true) then
			return other
		end
	end
	return nil
end

