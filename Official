local espHighlights = {}

local function clearEsp()
	for _, highlight in ipairs(espHighlights) do
		pcall(function()
			highlight:Destroy()
		end)
	end
	espHighlights = {}
end

local function applyEsp()
	clearEsp()
	if not State.Esp then
		return
	end
	for _, other in ipairs(others()) do
		local character = other.Character
		if character then
			local highlight = Instance.new("Highlight")
			highlight.Name = "SA_ESP"
			highlight.Adornee = character
			highlight.FillColor = Theme.Accent
			highlight.FillTransparency = State.Chams and 0.25 or 0.65
			highlight.OutlineColor = Theme.Accent
			highlight.OutlineTransparency = 0
			highlight.DepthMode = State.Chams and Enum.HighlightDepthMode.AlwaysOnTop
				or Enum.HighlightDepthMode.Occluded
			highlight.Parent = character
			espHighlights[#espHighlights + 1] = highlight
		end
	end
end

local function refreshEspColors()
	for _, highlight in ipairs(espHighlights) do
		if highlight.Parent then
			highlight.FillColor = Theme.Accent
			highlight.OutlineColor = Theme.Accent
		end
	end
end

-- ─────────────────────────────────────────────────────────────── helpers: hitbox
local hitboxOriginals = {}

local function resetHitbox()
	for other, original in pairs(hitboxOriginals) do
		local character = other.Character
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Size = original.Size
				hrp.Transparency = original.Transparency
				hrp.CanCollide = original.CanCollide
			end
		end
	end
	hitboxOriginals = {}
end

local function applyHitbox(multiplier)
	resetHitbox()
	if multiplier <= 1.001 then
		return
	end
	for _, other in ipairs(others()) do
		local character = other.Character
		if character then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hitboxOriginals[other] = {
					Size = hrp.Size,
					Transparency = hrp.Transparency,
					CanCollide = hrp.CanCollide,
				}
				hrp.Size = hrp.Size * multiplier
				hrp.Transparency = 0.72
				hrp.CanCollide = false
			end
		end
	end
end

