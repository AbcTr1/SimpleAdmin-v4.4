local function setWorldParticles(enabled)
	local count = 0
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then
			obj.Enabled = enabled
			count += 1
		end
	end
	return count
end

local function setWorldAnchored(anchored, radius)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local origin = hrp and hrp.Position
	local count = 0
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and not (character and part:IsDescendantOf(character)) then
			if radius and origin and (part.Position - origin).Magnitude > radius then
				continue
			end
			part.Anchored = anchored
			count += 1
		end
	end
	return count
end

local function setWorldCollision(enabled)
	local character = player.Character
	local count = 0
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and not (character and part:IsDescendantOf(character)) then
			part.CanCollide = enabled
			count += 1
		end
	end
	return count
end

