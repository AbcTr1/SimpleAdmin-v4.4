register("fling", "spin-fling onto the nearest player", "fling [name]", function(arg)
	local target = nil
	if arg and arg ~= "" then
		target = findPlayer(arg)
		if not target then
			err("no player matching: " .. arg)
			return
		end
	else
		local nearest, best = nil, math.huge
		local _, _, mine = myCharacter()
		if mine then
			for _, other in ipairs(others()) do
				local character = other.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local distance = (hrp.Position - mine.Position).Magnitude
					if distance < best then
						nearest, best = other, distance
					end
				end
			end
		end
		target = nearest
	end
	local flung, message = doFling(target)
	if flung then
		ok("fling → " .. (target and target.Name or "self") .. " (physics — shared when you own the part)")
	else
		err(message)
	end
end)

