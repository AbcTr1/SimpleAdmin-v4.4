-- ─────────────────────────────────────────────────────────────── log api
local MAX_LINES = CONFIG.MaxLines
local lines = {}

local function escape(text)
	text = tostring(text)
	text = string.gsub(text, "&", "&amp;")
	text = string.gsub(text, "<", "&lt;")
	text = string.gsub(text, ">", "&gt;")
	return text
end

local function flush()
	logText.Text = table.concat(lines, "\n")
	task.defer(function()
		logFrame.CanvasPosition = Vector2.new(0, math.max(logFrame.AbsoluteCanvasSize.Y - logFrame.AbsoluteWindowSize.Y, 0))
	end)
end

local function push(markup)
	lines[#lines + 1] = markup
	while #lines > MAX_LINES do
		table.remove(lines, 1)
	end
	flush()
end

local function say(text)
	push(string.format('<font color="%s">%s</font>', hex(Theme.Text), escape(text)))
end

local function note(text)
	push(string.format('<font color="%s">%s</font>', hex(Theme.Dim), escape(text)))
end

local function ok(text)
	push(string.format('<font color="%s">%s</font>', hex(Theme.Accent), escape(text)))
end

local function err(text)
	push(string.format('<font color="%s">%s</font>', hex(Theme.Error), escape(text)))
end

local function echo(raw)
	push(string.format(
		'<font color="%s">%s</font> <font color="%s">%s</font>',
		hex(Theme.Accent), escape(CONFIG.Prefix), hex(Theme.Text), escape(raw)
	))
end

