local connections = {}

local function track(name, connection)
	if connections[name] then
		connections[name]:Disconnect()
	end
	connections[name] = connection
end

local function untrack(name)
	if connections[name] then
		connections[name]:Disconnect()
		connections[name] = nil
	end
end

local function humanoid()
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function rootPart()
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function applyMovement()
	local hum = humanoid()
	if not hum then
		return
	end
	if State.Freeze then
		hum.WalkSpeed = 0
		hum.UseJumpPower = true
		hum.JumpPower = 0
	else
		hum.WalkSpeed = State.Speed
		hum.UseJumpPower = true
		hum.JumpPower = State.JumpPower
	end
end

-- fly
local flyBody, flyGyro, flyConnection

local function stopFly()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if flyBody then
		flyBody:Destroy()
		flyBody = nil
	end
	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end
	local hum = humanoid()
	if hum then
		hum.PlatformStand = false
	end
end

local function startFly()
	stopFly()
	local hum = humanoid()
	local hrp = rootPart()
	if not (hum and hrp) then
		return false
	end

	hum.PlatformStand = true

	local body = Instance.new("BodyVelocity")
	body.Name = "SA_FlyBody"
	body.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	body.Velocity = Vector3.zero
	body.Parent = hrp

	local gyro = Instance.new("BodyGyro")
	gyro.Name = "SA_FlyGyro"
	gyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	gyro.P = 8000
	gyro.D = 500
	gyro.CFrame = hrp.CFrame
	gyro.Parent = hrp

	flyBody, flyGyro = body, gyro

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not (flyBody and flyGyro) then
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local direction = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.yAxis
		end
		if direction.Magnitude > 0 then
			direction = direction.Unit
		end

		local target = direction * State.FlySpeed
		local alpha = 1 - math.exp(-dt * 14)
		flyBody.Velocity = flyBody.Velocity:Lerp(target, alpha)
		flyGyro.CFrame = camera.CFrame
	end)

	return true
end

-- noclip
local function setNoclip(enabled)
	untrack("noclip")
	if not enabled then
		local character = player.Character
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = true
				end
			end
		end
		return
	end

	local function sweep()
		local character = player.Character
		if not character then
			return
		end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end

	sweep()
	track("noclip", RunService.Stepped:Connect(sweep))
end

-- infinite jump
local function setInfiniteJump(enabled)
	untrack("infjump")
	if not enabled then
		return
	end
	track("infjump", UserInputService.JumpRequest:Connect(function()
		local hum = humanoid()
		if hum and hum:GetState() ~= Enum.HumanoidStateType.Dead then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end))
end

-- anti-afk
local function setAntiAfk(enabled)
	untrack("afk")
	if not enabled then
		return
	end
	local ok2 = pcall(function()
		local virtualUser = game:GetService("VirtualUser")
		track("afk", player.Idled:Connect(function()
			pcall(function()
				virtualUser:CaptureController()
				virtualUser:ClickButton2(Vector2.new())
			end)
		end))
	end)
	if not ok2 then
		State.AntiAfk = false
	end
end

-- lighting
local lightingBackup = {
	FullBright = nil,
	NoFog = nil,
}

local function setFullBright(enabled)
	if enabled then
		if not lightingBackup.FullBright then
			lightingBackup.FullBright = {
				Brightness = Lighting.Brightness,
				Ambient = Lighting.Ambient,
				OutdoorAmbient = Lighting.OutdoorAmbient,
				ClockTime = Lighting.ClockTime,
				GlobalShadows = Lighting.GlobalShadows,
			}
		end
		Lighting.Brightness = 2
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
	else
		local backup = lightingBackup.FullBright
		if backup then
			Lighting.Brightness = backup.Brightness
			Lighting.Ambient = backup.Ambient
			Lighting.OutdoorAmbient = backup.OutdoorAmbient
			Lighting.ClockTime = backup.ClockTime
			Lighting.GlobalShadows = backup.GlobalShadows
			lightingBackup.FullBright = nil
		end
	end
end

local function setNoFog(enabled)
	if enabled then
		if not lightingBackup.NoFog then
			lightingBackup.NoFog = {
				FogStart = Lighting.FogStart,
				FogEnd = Lighting.FogEnd,
				FogColor = Lighting.FogColor,
			}
		end
		Lighting.FogStart = 1e8
		Lighting.FogEnd = 1e8
	else
		local backup = lightingBackup.NoFog
		if backup then
			Lighting.FogStart = backup.FogStart
			Lighting.FogEnd = backup.FogEnd
			Lighting.FogColor = backup.FogColor
			lightingBackup.NoFog = nil
		end
	end
end

-- actions
local function teleportToMouse()
	local camera = workspace.CurrentCamera
	local hrp = rootPart()
	if not (camera and hrp) then
		return false
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
	if result then
		hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
		return true
	end
	return false
end

local function resetCharacter()
	local hum = humanoid()
	if hum then
		hum.Health = 0
	end
end

local function rejoin()
	pcall(function()
		TeleportService:Teleport(game.PlaceId, player)
	end)
end

local function applyAll()
	applyMovement()
	setNoclip(State.Noclip)
	setInfiniteJump(State.InfiniteJump)
	setAntiAfk(State.AntiAfk)
	setFullBright(State.FullBright)
	setNoFog(State.NoFog)
	if State.Fly then
		startFly()
	end
end

