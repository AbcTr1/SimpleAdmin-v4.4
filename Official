-- ─────────────────────────────────────────────────────────────── parser
local history = {}
local historyIndex = 0

local function execute(raw)
	local trimmed = string.gsub(raw, "^%s+", "")
	trimmed = string.gsub(trimmed, "%s+$", "")
	if trimmed == "" then
		return
	end

	echo(trimmed)
	history[#history + 1] = trimmed
	historyIndex = #history + 1

	local name, rest = string.match(trimmed, "^(%S+)%s*(.*)$")
	name = string.lower(name or "")
	rest = rest or ""
	name = aliases[name] or name

	local entry = commands[name]
	if not entry then
		err("unknown command: " .. name)
		note("type `help` for the list")
		return
	end

	local runOk, message = pcall(entry.handler, rest)
	if not runOk then
		err("command failed: " .. tostring(message))
	end
	refreshStatus()
end

