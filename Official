register("savetheme", "persist the palette to disk", "savetheme", function()
	local data = {}
	for key, value in pairs(Theme) do
		if typeof(value) == "Color3" then
			local r, g, b = round(value.R * 255), round(value.G * 255), round(value.B * 255)
			data[key] = { r, g, b }
		end
	end
	local encoded = HttpService:JSONEncode(data)
	shared.SimpleAdminTerminalTheme = encoded
	if CONFIG.Persist and writefile then
		pcall(writefile, "SimpleAdminTerminal.json", encoded)
	end
	ok("theme saved")
end)

register("loadtheme", "restore the saved palette", "loadtheme", function()
	local encoded = shared.SimpleAdminTerminalTheme
	if CONFIG.Persist and isfile and isfile("SimpleAdminTerminal.json") then
		local readOk, content = pcall(readfile, "SimpleAdminTerminal.json")
		if readOk then
			encoded = content
		end
	end
	if type(encoded) ~= "string" then
		err("no saved theme")
		return
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(encoded)
	end)
	if not decodeOk or type(data) ~= "table" then
		err("saved theme is corrupt")
		return
	end
	for key, value in pairs(data) do
		if Theme[key] ~= nil and type(value) == "table" and #value == 3 then
			Theme[key] = Color3.fromRGB(value[1], value[2], value[3])
		end
	end
	repaint()
	ok("theme loaded")
end)

