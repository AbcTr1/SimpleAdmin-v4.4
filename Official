UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		if awaitingKey then
			toggleKey = input.KeyCode
			awaitingKey = false
			ok("bound → " .. toggleKey.Name)
			refreshStatus()
			return
		end

		if inputBox:IsFocused() then
			if input.KeyCode == Enum.KeyCode.Escape then
				inputBox:ReleaseFocus()
				return
			elseif input.KeyCode == Enum.KeyCode.Up then
				if #history > 0 then
					historyIndex = math.max(1, historyIndex - 1)
					inputBox.Text = history[historyIndex]
					inputBox.CursorPosition = #inputBox.Text + 1
				end
				return
			elseif input.KeyCode == Enum.KeyCode.Down then
				if #history > 0 then
					historyIndex = math.min(#history + 1, historyIndex + 1)
					inputBox.Text = (historyIndex <= #history) and history[historyIndex] or ""
					inputBox.CursorPosition = #inputBox.Text + 1
				end
				return
			elseif input.KeyCode == Enum.KeyCode.Tab then
				local partial = string.lower(inputBox.Text)
				if partial == "" then
					return
				end
				local matches = {}
				for _, name in ipairs(order) do
					if string.sub(name, 1, #partial) == partial then
						matches[#matches + 1] = name
					end
				end
				if #matches == 1 then
					inputBox.Text = matches[1]
					inputBox.CursorPosition = #inputBox.Text + 1
				elseif #matches > 1 then
					note("matches: " .. table.concat(matches, " "))
				end
				return
			end
			return
		end

		if processed then
			return
		end

		if input.KeyCode == toggleKey then
			setOpen(not main.Visible)
		end
	end
end)

