-- ─────────────────────────────────────────────────────────────── character + physics hacks
-- Character edits are local; physics on parts you own is what other players feel.

local headOriginals = setmetatable({}, { __mode = "k" })
local neckOriginals = setmetatable({}, { __mode = "k" })
local rainbowOriginals = setmetatable({}, { __mode = "k" })
local rainbowHue = 0
local animatorConnection
local spamTrack

local function applySize(scale)
	local character = player.Character
	if not character then
		return false
	end
	return pcall(function()
		character:ScaleTo(scale)
	end)
end

local function applyHeadScale(mult)
	local character = player.Character
	if not character then
		return false
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return false
	end

	if head:IsA("MeshPart") then
		local original = headOriginals[head]
		if not original then
			original = head.Size
			headOriginals[head] = original
		end
		local neck = character:FindFirstChild("Neck", true)
		if neck and neck:IsA("Motor6D") and not neckOriginals[neck] then
			neckOriginals[neck] = neck.C0
		end
		head.Size = original * mult
		if neck and neckOriginals[neck] then
			neck.C0 = neckOriginals[neck] * CFrame.new(0, (head.Size.Y - original.Y) * 0.5, 0)
		end
		return true
	end

	local mesh = head:FindFirstChildOfClass("SpecialMesh")
	if not mesh then
		mesh = Instance.new("SpecialMesh")
		mesh.Name = "SA_HeadMesh"
		mesh.MeshType = Enum.MeshType.Head
		mesh.Parent = head
	end
	mesh.Scale = Vector3.new(mult, mult, mult)
	return true
end

local function applyAnimSpeed()
	local character = player.Character
	local animator = character and character:FindFirstChildOfClass("Animator")
	if not animator then
		return false
	end
	if animatorConnection then
		animatorConnection:Disconnect()
	end
	animatorConnection = animator.AnimationPlayed:Connect(function(track)
		pcall(function()
			track:AdjustSpeed(State.AnimSpeed)
		end)
	end)
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		pcall(function()
			track:AdjustSpeed(State.AnimSpeed)
		end)
	end
	return true
end

local function stripAccessories()
	local character = player.Character
	if not character then
		return 0
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum:RemoveAccessories()
		end)
	end
	local count = 0
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Accessory") then
			obj:Destroy()
			count += 1
		end
	end
	return count
end

local function rainbowStep()
	local character = player.Character
	if not character then
		return
	end
	rainbowHue = (rainbowHue + 0.02) % 1
	local index = 0
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			index += 1
			if not rainbowOriginals[part] then
				rainbowOriginals[part] = part.Color
			end
			part.Color = Color3.fromHSV((rainbowHue + index * 0.06) % 1, 1, 1)
		end
	end
end

local function rainbowRestore()
	for part, color in pairs(rainbowOriginals) do
		if part.Parent then
			part.Color = color
		end
	end
	rainbowOriginals = setmetatable({}, { __mode = "k" })
end

local function playAnimation(assetId, looped, speed)
	local character = player.Character
	local animator = character and character:FindFirstChildOfClass("Animator")
	if not animator then
		return nil, "no animator"
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://" .. tostring(assetId)
	local loadOk, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if not loadOk or not track then
		return nil, "bad animation id"
	end
	track.Looped = looped == true
	track:Play()
	pcall(function()
		track:AdjustSpeed(speed or 1)
	end)
	return track
end

local function cursorPoint(distance)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local result = workspace:Raycast(ray.Origin, ray.Direction * (distance or 1500), params)
	if result then
		return result.Position
	end
	return ray.Origin + ray.Direction * 40
end

local function spawnBlock(position, size, color, anchored)
	local part = Instance.new("Part")
	part.Size = Vector3.new(size, size, size)
	part.Position = position
	part.Color = color or Theme.Accent
	part.Material = Enum.Material.Neon
	part.Anchored = anchored == true
	part.CanCollide = true
	part.Parent = workspace
	return part
end

local function doFling(targetPlayer)
	local _, _, hrp = myCharacter()
	if not hrp then
		return false, "no character"
	end

	local otherHrp
	if targetPlayer and targetPlayer.Character then
		otherHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
	end
	if otherHrp then
		hrp.CFrame = otherHrp.CFrame
	end

	local mass = Instance.new("Part")
	mass.Name = "SA_Fling"
	mass.Size = Vector3.new(4, 4, 4)
	mass.Transparency = 1
	mass.CanCollide = false
	mass.Parent = hrp

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hrp
	weld.Part1 = mass
	weld.Parent = mass

	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < 1.5 and hrp.Parent and screen.Parent do
			hrp.AssemblyLinearVelocity = Vector3.new(
				math.random(-7000, 7000),
				math.random(4000, 11000),
				math.random(-7000, 7000)
			)
			hrp.CFrame = hrp.CFrame * CFrame.Angles(
				math.random() * 6,
				math.random() * 6,
				math.random() * 6
			)
			RunService.Heartbeat:Wait()
		end
		if mass.Parent then
			mass:Destroy()
		end
	end)

	return true
end

