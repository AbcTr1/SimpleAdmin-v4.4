register("load", "restore speed/jump/theme from disk", "load", function()
	local encoded = shared.SimpleAdminTerminalConfig
	if CONFIG.Persist and isfile and isfile(CONFIG_FILE) then
		local readOk, content = pcall(readfile, CONFIG_FILE)
		if readOk then
			encoded = content
		end
	end
	if type(encoded) ~= "string" then
		err("no saved config")
		return
	end
	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(encoded)
	end)
	if not decodeOk or type(data) ~= "table" then
		err("saved config is corrupt")
		return
	end
	State.Speed = tonumber(data.Speed) or State.Speed
	State.JumpPower = tonumber(data.JumpPower) or State.JumpPower
	State.FlySpeed = tonumber(data.FlySpeed) or State.FlySpeed
	State.Hitbox = tonumber(data.Hitbox) or State.Hitbox
	State.Size = tonumber(data.Size) or State.Size
	State.HeadScale = tonumber(data.HeadScale) or State.HeadScale
	State.AnimSpeed = tonumber(data.AnimSpeed) or State.AnimSpeed
	local theme = data.Theme
	if type(theme) == "table" then
		if type(theme.Accent) == "table" and #theme.Accent == 3 then
			Theme.Accent = Color3.fromRGB(theme.Accent[1], theme.Accent[2], theme.Accent[3])
		end
		if type(theme.Panel) == "table" and #theme.Panel == 3 then
			Theme.Panel = Color3.fromRGB(theme.Panel[1], theme.Panel[2], theme.Panel[3])
		end
	end
	applyMovement()
	if State.Size ~= 1 then
		applySize(State.Size)
	end
	if State.HeadScale ~= 1 then
		applyHeadScale(State.HeadScale)
	end
	applyAnimSpeed()
	repaint()
	ok("config loaded")
end)

